{
  "name": "dsh-studio",
  "version": "0.1.1",
  "description": "DSH Studio — DeepSeek Harness 桌面客户端（原生窗口封装 dsh Web UI）",
  "main": "./out/main/index.js",
  "type": "module",
  "license": "MIT",
  "author": "DSH Studio contributors",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/gen-icons.ps1",
    "build:plugin": "node scripts/build-plugin.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "dist:mac": "electron-vite build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "dsh-file-explorer": "0.1.1",
    "dsh-studio-appearance": "file:./plugins/dsh-studio-appearance",
    "electron-updater": "^6.8.9",
    "pnpm": "^10.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.10.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.30.0",
    "vite": "^7.0.0"
  }
}
